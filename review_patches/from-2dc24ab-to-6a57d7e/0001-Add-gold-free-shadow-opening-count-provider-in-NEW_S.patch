+
+def test_schedule_and_plan_agreement_is_firm(tmp_path: Path) -> None:
+    def schedule(doc: fitz.Document) -> None:
+        _add_schedule_page(
+            doc,
+            [
+                ["Mark", "Dimensions", "Quantity", "Description"],
