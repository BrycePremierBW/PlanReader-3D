+        and (
+            _is_opening_identity(str(row.get("semantic_key") or ""))
+            or str(row.get("family") or "") in OPENING_COUNT_FAMILIES
+        )
     ]
     agree = sum(1 for row in opening_comparisons if row.get("status") == "agree")
     compared = len(opening_comparisons)
