    "floor_finish_area_pct": 5.0,
    "internal_plaster_area_pct": 5.0,
    "external_pointing_area_pct": 5.0,
    "scheduled_doors_exact": true,
    "scheduled_windows_exact": true,
    "verandah_pillars_exact": true
  }
}